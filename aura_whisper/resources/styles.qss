/* ======================================================================
   AuraWhisper — macOS (Tahoe-style) dark appearance
   ----------------------------------------------------------------------
   Tokens (keep in sync with ui_kit.py):
     window        #1E1E20        accent        #0A84FF (systemBlue)
     sidebar       white / 5%     accent press  #0070E0
     grouped card  white / 5%     green         #30D158
     hairline      white / 8%     red           #FF453A
     control fill  white / 10%    label         #F5F5F7
     secondary     #A1A1A6        tertiary      #6E6E73
   ====================================================================== */

QWidget {
    color: #F5F5F7;
    font-family: ".AppleSystemUIFont", "SF Pro Text", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

/* ---------- Main window ---------- */

#titleBar { background: transparent; }
#titleLabel {
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 600;
}
#modeLabel {
    background: rgba(10, 132, 255, 0.18);
    color: #64B5FF;
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
}

#toolBtn, #closeBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}
#toolBtn:hover { background: rgba(255, 255, 255, 0.10); }
#toolBtn:pressed { background: rgba(255, 255, 255, 0.16); }
#closeBtn:hover { background: rgba(255, 69, 58, 0.40); }

#transcription {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    color: #F5F5F7;
    selection-background-color: rgba(10, 132, 255, 0.55);
    padding: 12px 14px;
    font-size: 15px;
}

#copyBtn, #clearBtn {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-radius: 13px;
    color: #F5F5F7;
    font-weight: 500;
    padding: 5px 14px;
    min-height: 16px;
}
#copyBtn:hover, #clearBtn:hover { background: rgba(255, 255, 255, 0.15); }
#copyBtn:pressed, #clearBtn:pressed { background: rgba(255, 255, 255, 0.22); }
#copyBtn {
    background: #0A84FF;
    color: #FFFFFF;
}
#copyBtn:hover { background: #2E96FF; }
#copyBtn:pressed { background: #0070E0; }

#status {
    color: #A1A1A6;
    font-size: 11px;
    padding-left: 4px;
}

/* ---------- Dialog surfaces ---------- */

QDialog {
    background: #1E1E20;
    color: #F5F5F7;
}
QStackedWidget { background: transparent; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }

/* ---------- Text fields ---------- */

QLineEdit {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 7px;
    padding: 5px 9px;
    color: #F5F5F7;
    min-height: 18px;
    selection-background-color: rgba(10, 132, 255, 0.55);
}
QLineEdit:focus {
    border: 1px solid #0A84FF;
    background: rgba(0, 0, 0, 0.32);
}
QLineEdit:disabled { color: #6E6E73; }

/* ---------- Pop-up buttons (combo boxes) ---------- */

QComboBox {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 7px;
    padding: 5px 30px 5px 10px;
    color: #F5F5F7;
    min-height: 18px;
}
QComboBox:hover { background: rgba(255, 255, 255, 0.14); }
QComboBox:on { background: rgba(255, 255, 255, 0.17); }
QComboBox:disabled { color: #6E6E73; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    margin-right: 5px;
    border: none;
    border-radius: 4px;
    background: #0A84FF;
}
QComboBox::down-arrow {
    image: url("__RES__/chevron-updown.svg");
    width: 7px;
    height: 11px;
}
QComboBox QAbstractItemView {
    background: #2A2A2D;
    color: #F5F5F7;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 5px;
    outline: none;
    selection-background-color: transparent;
}
QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 3px 10px;
    border-radius: 5px;
    color: #F5F5F7;
}
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background: #0A84FF;
    color: #FFFFFF;
}

/* ---------- Check boxes (legacy) ---------- */

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
}
QCheckBox::indicator:checked {
    background: #0A84FF;
    border-color: #0A84FF;
    image: url("__RES__/icons/check.svg");
}

/* ---------- Push buttons ---------- */

QPushButton {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 7px;
    padding: 5px 14px;
    color: #F5F5F7;
    font-weight: 500;
    min-height: 18px;
}
QPushButton:hover { background: rgba(255, 255, 255, 0.17); }
QPushButton:pressed { background: rgba(255, 255, 255, 0.24); }
QPushButton:disabled { color: #6E6E73; background: rgba(255, 255, 255, 0.06); }
QPushButton:default {
    background: #0A84FF;
    color: #FFFFFF;
}
QPushButton:default:hover { background: #2E96FF; }
QPushButton:default:pressed { background: #0070E0; }

/* ---------- Scroll bars (thin, overlay-like) ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.22);
    border-radius: 3px;
    min-height: 28px;
    margin: 0 2px;
}
QScrollBar::handle:vertical:hover { background: rgba(255, 255, 255, 0.36); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

/* ---------- Tabs (legacy) ---------- */

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: #A1A1A6;
    border: none;
    padding: 5px 14px;
    margin: 2px;
    border-radius: 6px;
    font-weight: 500;
}
QTabBar::tab:selected { background: rgba(255, 255, 255, 0.16); color: #FFFFFF; }
QTabBar::tab:hover:!selected { background: rgba(255, 255, 255, 0.07); }

/* ---------- Tables & lists ---------- */

QTableWidget, QListWidget {
    background: rgba(255, 255, 255, 0.04);
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
    padding: 4px;
}
QTableWidget::item, QListWidget::item {
    padding: 5px 8px;
    border: none;
    border-radius: 6px;
    color: #F5F5F7;
}
QListWidget::item:selected, QTableWidget::item:selected {
    background: #0A84FF;
    color: #FFFFFF;
}
QListWidget::item:hover:!selected { background: rgba(255, 255, 255, 0.06); }
QHeaderView::section {
    background: transparent;
    color: #A1A1A6;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 600;
}
QTableCornerButton::section { background: transparent; border: none; }

/* ---------- Text editor & progress ---------- */

QTextEdit {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 7px 9px;
    color: #F5F5F7;
    selection-background-color: rgba(10, 132, 255, 0.55);
}
QTextEdit:focus { border: 1px solid #0A84FF; }

QProgressBar {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
    color: transparent;
    font-size: 1px;
}
QProgressBar::chunk {
    background: #0A84FF;
    border-radius: 3px;
}

/* ---------- Menus & tooltips ---------- */

QMenu {
    background: #2A2A2D;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 5px;
}
QMenu::item {
    padding: 4px 22px 4px 10px;
    border-radius: 5px;
    color: #F5F5F7;
}
QMenu::item:selected { background: #0A84FF; color: #FFFFFF; }
QMenu::item:disabled { color: #6E6E73; }
QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.10);
    margin: 4px 10px;
}

QToolTip {
    background: #2A2A2D;
    color: #F5F5F7;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 4px 8px;
}

/* ---------- Labels ---------- */

QLabel[hint="true"] { color: #A1A1A6; font-size: 11px; }
QLabel[sectionTitle="true"] {
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 700;
    padding-top: 2px;
}

/* ---------- Grouped cards ---------- */

QFrame[card="true"] {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
}
QFrame[card="true"] QLabel[sectionTitle="true"] { padding-top: 0; }

/* ---------- Hotkey picker: keycaps ---------- */

QPushButton[modKey="true"] {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 2px solid rgba(0, 0, 0, 0.35);
    border-radius: 7px;
    color: #A1A1A6;
    font-size: 14px;
    font-weight: 500;
    padding: 3px 0;
    min-height: 20px;
}
QPushButton[modKey="true"]:hover { background: rgba(255, 255, 255, 0.13); color: #F5F5F7; }
QPushButton[modKey="true"]:checked {
    background: #0A84FF;
    border: 1px solid #2E96FF;
    border-bottom: 2px solid #0058B8;
    color: #FFFFFF;
}
QPushButton[modKey="true"]:checked:hover { background: #2E96FF; }

QPushButton#recordHotkeyBtn {
    background: rgba(255, 255, 255, 0.10);
    border: none;
    border-radius: 13px;
    color: #F5F5F7;
    font-weight: 500;
}
QPushButton#recordHotkeyBtn:hover { background: rgba(255, 255, 255, 0.16); }
QPushButton#recordHotkeyBtn:checked {
    background: #FF453A;
    color: #FFFFFF;
}

/* ---------- Settings: page headers ---------- */

QLabel[pageTitle="true"] {
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 700;
}
QLabel[pageSubtitle="true"] {
    color: #A1A1A6;
    font-size: 12px;
}
QLabel[groupCaption="true"] {
    color: #A1A1A6;
    font-size: 11px;
    font-weight: 600;
    padding-top: 2px;
}
QLabel[toggleHint="true"] {
    color: #A1A1A6;
    font-size: 11px;
    padding-left: 24px;
    padding-bottom: 2px;
}

/* ---------- Settings: AI Modes page ---------- */

QLabel[fieldLabel="true"] {
    color: #A1A1A6;
    font-size: 12px;
    font-weight: 500;
    padding-top: 6px;
}

QListWidget#modePicker {
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 5px;
}
QListWidget#modePicker::item {
    padding: 6px 10px;
    margin: 1px 0;
    border-radius: 6px;
    color: #F5F5F7;
    font-size: 13px;
}
QListWidget#modePicker::item:selected { background: #0A84FF; color: #FFFFFF; }
QListWidget#modePicker::item:hover:!selected { background: rgba(255, 255, 255, 0.06); }

QPushButton#addModeBtn {
    background: rgba(10, 132, 255, 0.18);
    border: none;
    color: #64B5FF;
    font-weight: 600;
    border-radius: 7px;
}
QPushButton#addModeBtn:hover { background: rgba(10, 132, 255, 0.28); }

QFrame#cardDivider {
    background: rgba(255, 255, 255, 0.08);
    border: none;
}

/* ======================================================================
   Grouped sections, rows, pills, sidebar, footer
   ====================================================================== */

/* Bold, sentence-case group header above each card (System Settings). */
QLabel[sectionCaption="true"] {
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 700;
    padding-left: 2px;
}

QWidget[settingRow="true"] { background: transparent; }
QLabel[rowTitle="true"] {
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 400;
}
QLabel[rowSubtitle="true"] {
    color: #A1A1A6;
    font-size: 11px;
}
QFrame[rowDivider="true"] {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    margin-left: 14px;
    margin-right: 14px;
}

/* Status / badge pills. */
QLabel[pill="true"] {
    border-radius: 8px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 600;
}
QLabel[pill="true"][tone="neutral"] {
    background: rgba(255, 255, 255, 0.10);
    color: #C7C7CC;
}
QLabel[pill="true"][tone="accent"] {
    background: rgba(10, 132, 255, 0.20);
    color: #64B5FF;
}
QLabel[pill="true"][tone="success"] {
    background: rgba(48, 209, 88, 0.18);
    color: #4CE07A;
}

/* Floating sidebar panel. */
QFrame#settingsSidebar {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}
QWidget#appIdentity { background: transparent; }
QLabel#brandTitle {
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 700;
}
QLabel#brandKicker {
    color: #A1A1A6;
    font-size: 11px;
}

QPushButton[navItem="true"] {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #F5F5F7;
    font-size: 13px;
    font-weight: 400;
    text-align: left;
    padding: 5px 8px;
    min-height: 24px;
}
QPushButton[navItem="true"]:hover { background: rgba(255, 255, 255, 0.06); }
QPushButton[navItem="true"]:checked {
    background: #0A84FF;
    color: #FFFFFF;
    font-weight: 500;
}

/* Bottom action bar. */
QFrame#settingsFooter {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
}
QPushButton#saveBtn, QPushButton#cancelBtn {
    border-radius: 14px;
    padding: 6px 20px;
    min-width: 56px;
    min-height: 16px;
    font-weight: 500;
}
QPushButton#saveBtn {
    background: #0A84FF;
    border: none;
    color: #FFFFFF;
}
QPushButton#saveBtn:hover { background: #2E96FF; }
QPushButton#saveBtn:pressed { background: #0070E0; }
QPushButton#cancelBtn {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #F5F5F7;
}
QPushButton#cancelBtn:hover { background: rgba(255, 255, 255, 0.18); }

/* Primary / secondary actions (Models page). */
QPushButton#downloadBtn {
    background: #0A84FF;
    border: none;
    border-radius: 13px;
    color: #FFFFFF;
    font-weight: 600;
    padding: 5px 16px;
}
QPushButton#downloadBtn:hover { background: #2E96FF; }
QPushButton#downloadBtn:pressed { background: #0070E0; }
QPushButton#downloadBtn:disabled { background: rgba(10, 132, 255, 0.35); color: rgba(255, 255, 255, 0.6); }
QPushButton#secondaryBtn {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    border-radius: 13px;
    color: #F5F5F7;
    font-weight: 500;
    padding: 5px 14px;
}
QPushButton#secondaryBtn:hover { background: rgba(255, 255, 255, 0.18); }
